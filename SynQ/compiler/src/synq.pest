// SynQ Language Grammar
// Spec: modules, rich types, events, named errors, roles, interfaces, upgrades

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* ~ ("\n" | EOI)
             | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

source_file = { SOI ~ top_level_item* ~ EOI }
top_level_item = { pragma_directive | synq_pragma | struct_definition
                 | enum_definition | interface_definition | contract_definition }

// ── Pragmas ──────────────────────────────────────────────────────────────────
pragma_directive = { "@" ~ IDENT ~ string_literal }
synq_pragma      = { "pragma" ~ "synq" ~ ("^" | "~" | ">=" | "")? ~ version_number ~ ";" }
version_number   = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)* }

// ── Struct ───────────────────────────────────────────────────────────────────
struct_definition = { "struct" ~ IDENT ~ "{" ~ struct_field* ~ "}" }
struct_field = { IDENT ~ ":" ~ type_decl ~ ";" }

// ── Enum ──────────────────────────────────────────────────────────────────────
enum_definition = { "enum" ~ IDENT ~ "{" ~ enum_variant* ~ "}" }
enum_variant    = { IDENT ~ ("(" ~ param_list? ~ ")")? ~ (",")? }

// ── Interface ────────────────────────────────────────────────────────────────
interface_definition = { "interface" ~ IDENT ~ "{" ~ interface_fn* ~ "}" }
interface_fn = { function_keyword ~ IDENT ~ "(" ~ param_list? ~ ")" ~ return_type? ~ ";" }

// ── Contract ─────────────────────────────────────────────────────────────────
// `implements InterfaceName` is optional
contract_definition = { "contract" ~ IDENT ~ implements_clause? ~ "{"
                        ~ contract_section* ~ "}" }
implements_clause = { "implements" ~ IDENT ~ ("," ~ IDENT)* }

contract_section = { state_section
                   | events_section
                   | errors_section
                   | roles_section
                   | metadata_section
                   | security_section
                   | impl_section
                   | tests_section
                   | enum_definition
                   // Flat (legacy) items inside contract body for backwards compat
                   | state_variable_declaration
                   | function_definition }

state_section    = { "state"    ~ "{" ~ state_variable_declaration* ~ "}" }
events_section   = { "events"   ~ "{" ~ event_definition* ~ "}" }
errors_section   = { "errors"   ~ "{" ~ error_definition* ~ "}" }
roles_section    = { "roles"    ~ "{" ~ role_definition* ~ "}" }
metadata_section = { "metadata" ~ "{" ~ metadata_entry* ~ "}" }
impl_section     = { "impl"     ~ "{" ~ function_definition* ~ "}" }
security_section  = { "security" ~ "{" ~ security_entry* ~ "}" }
security_entry   = { IDENT ~ ":" ~ (string_literal | bool_literal | number_literal) ~ ";" }
tests_section    = { "tests"    ~ "{" ~ function_definition* ~ "}" }

// ── State variables ──────────────────────────────────────────────────────────
state_variable_declaration = { IDENT ~ ":" ~ type_decl ~ ";" }

// ── Events ───────────────────────────────────────────────────────────────────
event_definition = { "event" ~ IDENT ~ "(" ~ event_param_list? ~ ")" ~ ";" }
event_param_list = { event_param ~ ("," ~ event_param)* }
event_param      = { indexed_keyword? ~ IDENT ~ ":" ~ type_decl }
indexed_keyword  = _{ "indexed" }

// ── Named errors ─────────────────────────────────────────────────────────────
error_definition = { "error" ~ IDENT ~ ("(" ~ param_list? ~ ")")? ~ ";" }

// ── Roles ────────────────────────────────────────────────────────────────────
// role Admin = cap::Minter + cap::Burner;
role_definition = { "role" ~ IDENT ~ "=" ~ cap_list_expr ~ ";" }
cap_list_expr   = { cap_item ~ ("+" ~ cap_item)* }

// ── Metadata entries ─────────────────────────────────────────────────────────
metadata_entry  = { IDENT ~ "=" ~ (string_literal | number_literal) ~ ";" }

// ── Functions ────────────────────────────────────────────────────────────────
function_keyword = _{ "function" | "fn" }
visibility_keyword = { "pub" | "priv" | "view" | "external" | "internal" }
return_type      = _{ "->" ~ type_decl }

identity_clause   = { "as" ~ "caller" }
// A function can have multiple `requires` clauses — each line is either
// cap/role requirements ("requires cap::Admin") or state preconditions
// ("requires balance_of[caller] >= amount").  PEG ordered choice: access_req_list
// is tried first; if it fails (not cap::/role::), state_condition_list matches.
requires_clauses  = { ("requires" ~ req_body)+ }
req_body          = { access_req_list | state_condition_list }
modifies_clauses  = { ("modifies" ~ modifies_list)+ }

access_req_list   = { access_req_item ~ ("," ~ access_req_item)* }
access_req_item   = { cap_item | role_item }
cap_item          = { "cap"  ~ "::" ~ IDENT }
role_item         = { "role" ~ "::" ~ IDENT }

// State preconditions parsed as raw strings — not compiled to bytecode.
// Stops at: comma (list separator), `modifies` keyword (next clause), `{` (block start)
state_condition_list = { state_condition ~ ("," ~ state_condition)* }
state_condition      = { (!"," ~ !"modifies" ~ !"requires" ~ !"{" ~ ANY)+ }

// Modifies declarations: "modifies balance_of[caller], balance_of[to]"
modifies_list        = { modifies_item ~ ("," ~ modifies_item)* }
modifies_item        = { IDENT ~ ("[" ~ expression ~ "]")? }

// ── Attributes (spec v7.0) ────────────────────────────────────────────────────
// Attributes appear before a function definition, one per line:
//   @public
//   @authority(AdminScope)
//   @effects(balance, supply)
//   @requires(balance_of[caller] >= amount)
//   @ensures(balance == old_balance + amount)
//   @fails(InsufficientFunds)
//   @bounded(1000000)
//   @manifest
//   @ai
attribute_list      = { attribute+ }
attribute           = { "@" ~ IDENT ~ ("(" ~ attribute_args ~ ")")? }
attribute_args      = { (!")" ~ ANY)+ }

// identity_clause? ~ return_type? ~ identity_clause? — supports both
// `as caller -> T` and `-> T as caller` orderings (either clause is optional)
function_definition = { attribute_list? ~ visibility_keyword? ~ function_keyword ~ IDENT ~ "(" ~ param_list? ~ ")"
                        ~ identity_clause? ~ return_type? ~ identity_clause?
                        ~ requires_clauses? ~ modifies_clauses? ~ block }
param_list = { param ~ ("," ~ param)* }
param      = { IDENT ~ ":" ~ type_decl }

// ── Block & Statements ───────────────────────────────────────────────────────
block = { "{" ~ statement* ~ "}" }

statement = { return_statement
            | require_statement
            | trap_statement
            | revert_enum_statement
            | revert_statement
            | emit_statement
            | extern_call_statement
            | while_statement
            | break_statement
            | continue_statement
            | if_statement
            | let_destructure
            | let_statement
            | map_assign_statement
            | set_op_statement
            | field_assign_statement
            | assignment_statement
            | expr_statement }

return_statement      = { "return" ~ expression? ~ ";" }
require_statement     = { "require" ~ "(" ~ expression ~ "," ~ string_literal ~ ")" ~ ";" }
revert_statement      = { "revert" ~ IDENT ~ ("(" ~ arg_list? ~ ")")? ~ ";" }
revert_enum_statement = { "revert" ~ IDENT ~ "::" ~ IDENT ~ ("(" ~ arg_list? ~ ")")? ~ ";" }
trap_statement       = { "trap" ~ (number_literal | IDENT)? ~ ";" }
emit_statement        = { "emit" ~ IDENT ~ "(" ~ arg_list? ~ ")" ~ ";" }
extern_call_statement = { "extern_call" ~ "(" ~ string_literal ~ "," ~ string_literal
                          ~ ("," ~ expression)* ~ ")" ~ ";" }
if_statement          = { "if" ~ "(" ~ expression ~ ")" ~ block
                          ~ ("else" ~ (if_statement | block))? }
while_statement       = { "while" ~ "(" ~ expression ~ ")" ~ block }
break_statement       = { "break" ~ ";" }
continue_statement    = { "continue" ~ ";" }
let_statement         = { "let" ~ IDENT ~ (":" ~ type_decl)? ~ "=" ~ expression ~ ";" }
let_destructure       = { "let" ~ "(" ~ IDENT ~ ("," ~ IDENT)+ ~ ")" ~ "=" ~ expression ~ ";" }
assignment_statement  = { IDENT ~ "=" ~ expression ~ ";" }
field_assign_statement = { IDENT ~ "." ~ IDENT ~ "=" ~ expression ~ ";" }
map_assign_statement  = { IDENT ~ ("[" ~ expression ~ "]")+ ~ "=" ~ expression ~ ";" }
set_op_statement      = { IDENT ~ "." ~ ("add" | "remove") ~ "(" ~ expression ~ ")" ~ ";" }
expr_statement        = { expression ~ ";" }

// ── Expressions ──────────────────────────────────────────────────────────────
expression = { logical }

logical    = { comparison ~ (logical_op ~ comparison)* }
logical_op = { "||" | "&&" }

comparison = { additive ~ (compare_op ~ additive)* }
compare_op = { ">=" | "<=" | "!=" | "==" | ">" | "<" }

additive = { multiplicative ~ (add_op ~ multiplicative)* }
add_op   = { "+" | "-" }

multiplicative = { unary ~ (mul_op ~ unary)* }
mul_op         = { "*" | "/" | "%" }

unary   = { ("-" ~ unary) | ("!" ~ unary) | postfix }
postfix = { primary ~ postfix_suffix* }
postfix_suffix = { "." ~ (IDENT ~ ("(" ~ arg_list? ~ ")")? | number_literal) }
primary = { self_access | map_index_expr | enum_access_expr | struct_literal
             | some_expr | none_expr | ok_expr | err_expr | call_expr
             | tuple_literal | literal | "(" ~ expression ~ ")" | IDENT }
map_index_expr  = { IDENT ~ ("[" ~ expression ~ "]")+ }
self_access = { "self" ~ "." ~ IDENT }


call_expr = { IDENT ~ "(" ~ arg_list? ~ ")" }
arg_list  = { expression ~ ("," ~ expression)* }

// ── Literals ─────────────────────────────────────────────────────────────────
literal        = { bool_literal | hex_literal | number_literal | string_literal }
number_literal = @{ ASCII_DIGIT+ }
hex_literal    = @{ "0x" ~ ASCII_HEX_DIGIT+ }
string_literal = @{ "\"" ~ (!("\"") ~ ANY)* ~ "\"" }
bool_literal   = { "true" | "false" }

// ── Field access & struct literal ──────────────────────────────────────────────
// field_access_expr and method_call_expr are now handled by the postfix rule

// `EnumName::VariantName` — access an enum variant (resolves to sequential tag I32)
enum_access_expr = { IDENT ~ "::" ~ IDENT }

// `TypeName { field1: expr, field2: expr }` — construct a struct value
struct_literal = { IDENT ~ "{" ~ struct_field_init ~ ("," ~ struct_field_init)* ~ "}" }
struct_field_init = { IDENT ~ ":" ~ expression }

// ── Constructed expressions ──────────────────────────────────────────────────────
tuple_literal = { "(" ~ expression ~ ("," ~ expression)+ ~ ")" }
some_expr     = { "Some" ~ "(" ~ expression ~ ")" }
none_expr     = { "None" }
ok_expr       = { "Ok"   ~ "(" ~ expression ~ ")" }
err_expr      = { "Err"  ~ "(" ~ expression ~ ")" }

// ── Types ────────────────────────────────────────────────────────────────────
// Full numeric tower: u8..u256, i8..i256 + aliases + option/result/tuple
type_decl = { option_type | result_type | tuple_type | mapping_type | set_type | array_type | asset_type
                 | bytes_type | hash_type | uma_type | IDENT }

bytes_type = { "Bytes" ~ "<" ~ number_literal ~ ">" }
hash_type  = { "Hash32" | "Hash64" }
uma_type   = { "UMAIdentity" | "ModelId" | "Height" }

option_type  = { "Option"  ~ "<" ~ type_decl ~ ">" }
result_type  = { "Result"  ~ "<" ~ type_decl ~ "," ~ type_decl ~ ">" }
tuple_type   = { "(" ~ type_decl ~ ("," ~ type_decl)+ ~ ")" }
mapping_type = { ("mapping" | "map") ~ "<" ~ type_decl ~ "," ~ type_decl ~ ">" }
set_type     = { "set" ~ "<" ~ type_decl ~ ">" }
array_type   = { "[" ~ type_decl ~ "]" }
asset_type   = { "Asset" ~ "<" ~ type_decl ~ ">" }

IDENT = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
