pragma synq ^0.9;

contract ComprehensiveToken {
  total_supply:  UInt256;
  balances:      mapping<UInt256, UInt256>;
  admin_role:    mapping<UInt256, UInt256>;
  minter_role:   mapping<UInt256, UInt256>;
  registered:    mapping<UInt256, UInt256>;
  feat_pqc:      UInt256;
  version:       UInt256;
  initialised:   UInt256;
  admin_count:   UInt256;

  // Bootstrap: sign this call with your wallet — caller becomes the first admin.
  // No deployer arg needed; the signer IS the deployer.
  function init() as caller {
    require(initialised == 0, "init: already initialised");
    admin_role[caller]  = 1;
    registered[caller]  = 1;
    admin_count         = 1;
    feat_pqc            = 1;
    version             = 1;
    initialised         = 1;
    return caller;
  }

  // ── Admin management ───────────────────────────────────────────────────────
  function grantAdmin(target: UInt256) as caller {
    require(admin_role[caller] == 1, "grantAdmin: not admin");
    require(target > 0,              "grantAdmin: invalid address");
    if (admin_role[target] == 0) {
      admin_count = admin_count + 1;
    }
    admin_role[target]  = 1;
    registered[target]  = 1;
  }

  function revokeAdmin(target: UInt256) as caller {
    require(admin_role[caller] == 1, "revokeAdmin: not admin");
    require(target != caller,        "revokeAdmin: cannot revoke self");
    require(admin_count > 1,         "revokeAdmin: cannot remove last admin");
    if (admin_role[target] == 1) {
      admin_count = admin_count - 1;
    }
    admin_role[target] = 0;
  }

  function grantMinter(target: UInt256) as caller {
    require(admin_role[caller] == 1, "grantMinter: not admin");
    require(target > 0,              "grantMinter: invalid address");
    minter_role[target]  = 1;
    registered[target]   = 1;
  }

  function revokeMinter(target: UInt256) as caller {
    require(admin_role[caller] == 1, "revokeMinter: not admin");
    require(target != caller,        "revokeMinter: cannot revoke self");
    minter_role[target] = 0;
  }

  // ── Explicit registration (admin only) ─────────────────────────────────────
  function register(target: UInt256) as caller {
    require(admin_role[caller] == 1, "register: not admin");
    require(target > 0,              "register: invalid address");
    registered[target] = 1;
  }

  function deregister(target: UInt256) as caller {
    require(admin_role[caller] == 1,  "deregister: not admin");
    require(balances[target] == 0,    "deregister: target still holds tokens");
    registered[target] = 0;
  }

  // ── Minting ────────────────────────────────────────────────────────────────
  function mint(to: UInt256, amount: UInt256) as caller {
    require(minter_role[caller] == 1 || admin_role[caller] == 1, "mint: not authorised");
    require(to > 0,     "mint: invalid recipient");
    require(amount > 0, "mint: positive");
    registered[to]   = 1;
    total_supply     = total_supply + amount;
    balances[to]     = balances[to] + amount;
    return total_supply;
  }

  // ── Transfers ──────────────────────────────────────────────────────────────
  function transfer(to: UInt256, amount: UInt256) as caller {
    require(registered[caller] == 1,    "transfer: sender not registered");
    require(registered[to] == 1,        "transfer: recipient not registered");
    require(to > 0,                     "transfer: invalid recipient");
    require(to != caller,               "transfer: cannot transfer to self");
    require(balances[caller] >= amount, "transfer: insufficient balance");
    balances[caller] = balances[caller] - amount;
    balances[to]     = balances[to] + amount;
    return 1;
  }

  function burn(from: UInt256, amount: UInt256) as caller {
    require(admin_role[caller] == 1,  "burn: not admin");
    require(balances[from] >= amount, "burn: amount exceeds balance");
    balances[from] = balances[from] - amount;
    total_supply   = total_supply - amount;
    return total_supply;
  }

  // ── Diagnostics ────────────────────────────────────────────────────────────
  function whoAmI() as caller       { return caller; }
  function amIAdmin() as caller     { return admin_role[caller]; }
  function amIRegistered() as caller { return registered[caller]; }

  // ── Queries ────────────────────────────────────────────────────────────────
  function isAdmin(who: UInt256)      { return admin_role[who]; }
  function isMinter(who: UInt256)     { return minter_role[who]; }
  function isRegistered(who: UInt256) { return registered[who]; }
  function balanceOf(who: UInt256)    { return balances[who]; }
  function totalSupply()              { return total_supply; }
}