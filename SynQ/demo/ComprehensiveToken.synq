pragma synq ^0.9;

// ComprehensiveToken v2 — exercises bool, str, map<u256,bool>, map<u256,str>
// and the str_concat / str_len / str_eq builtins alongside the full ERC-20-style
// token surface.  All state-mutating functions require `as caller` (EIP-712 auth).

contract ComprehensiveToken {

  state {
    // ── Numeric state ──────────────────────────────────────────────────────
    total_supply:  u256;
    admin_count:   u256;
    version:       u256;

    // ── Boolean state (Bool type) ──────────────────────────────────────────
    initialised:   bool;
    feat_pqc:      bool;
    debug_mode:    bool;

    // ── String state (Str type) ────────────────────────────────────────────
    token_name:    str;
    token_symbol:  str;

    // ── Role mappings (map<u256, bool>) ────────────────────────────────────
    admin_role:    map<u256, bool>;
    minter_role:   map<u256, bool>;
    registered:    map<u256, bool>;

    // ── Balance mapping (map<u256, u256>) ──────────────────────────────────
    balances:      map<u256, u256>;

    // ── Label mapping (map<u256, str>) — optional per-address label ────────
    labels:        map<u256, str>;
  }

  impl {

    // ── Bootstrap ──────────────────────────────────────────────────────────
    // Sign with your wallet — caller becomes the first admin.
    function init(name: str, symbol: str) -> bool as caller {
      if (initialised) { return false; }
      require(str_len(name) > 0,     "init: name empty");
      require(str_len(symbol) > 0,   "init: symbol empty");
      require(str_len(name) <= 64,   "init: name too long");
      require(str_len(symbol) <= 8,  "init: symbol too long");

      admin_role[caller]  = true;
      registered[caller]  = true;
      admin_count         = 1;
      feat_pqc            = true;
      version             = 2;
      token_name          = name;
      token_symbol        = symbol;
      initialised         = true;
      debug_mode          = false;
      return true;
    }

    // ── Admin management ───────────────────────────────────────────────────
    function grantAdmin(target: u256) -> bool as caller {
      require(admin_role[caller] == true, "grantAdmin: not admin");
      require(target > 0,                 "grantAdmin: invalid address");
      if (admin_role[target] == false) {
        admin_count = admin_count + 1;
      }
      admin_role[target]  = true;
      registered[target]  = true;
      return true;
    }

    function revokeAdmin(target: u256) -> bool as caller {
      require(admin_role[caller] == true, "revokeAdmin: not admin");
      require(target != caller,           "revokeAdmin: cannot revoke self");
      require(admin_count > 1,            "revokeAdmin: cannot remove last admin");
      if (admin_role[target] == true) {
        admin_count = admin_count - 1;
      }
      admin_role[target] = false;
      return true;
    }

    function grantMinter(target: u256) -> bool as caller {
      require(admin_role[caller] == true, "grantMinter: not admin");
      require(target > 0,                 "grantMinter: invalid address");
      minter_role[target] = true;
      registered[target]  = true;
      return true;
    }

    function revokeMinter(target: u256) -> bool as caller {
      require(admin_role[caller] == true, "revokeMinter: not admin");
      require(target != caller,           "revokeMinter: cannot revoke self");
      minter_role[target] = false;
      return true;
    }

    // ── Registration ───────────────────────────────────────────────────────
    function register(target: u256) -> bool as caller {
      require(admin_role[caller] == true, "register: not admin");
      require(target > 0,                 "register: invalid address");
      registered[target] = true;
      return true;
    }

    function deregister(target: u256) -> bool as caller {
      require(admin_role[caller] == true,  "deregister: not admin");
      require(balances[target] == 0,       "deregister: target still holds tokens");
      registered[target] = false;
      return true;
    }

    // ── Token metadata (admin only) ────────────────────────────────────────
    function setTokenName(name: str) -> bool as caller {
      require(admin_role[caller] == true, "setTokenName: not admin");
      require(str_len(name) > 0,          "setTokenName: empty");
      require(str_len(name) <= 64,        "setTokenName: too long");
      token_name = name;
    }

    function setTokenSymbol(symbol: str) -> bool as caller {
      require(admin_role[caller] == true, "setTokenSymbol: not admin");
      require(str_len(symbol) > 0,        "setTokenSymbol: empty");
      require(str_len(symbol) <= 8,       "setTokenSymbol: too long");
      token_symbol = symbol;
    }

    // ── Per-address labels (admin only) ────────────────────────────────────
    function setLabel(target: u256, label: str) -> bool as caller {
      require(admin_role[caller] == true, "setLabel: not admin");
      require(str_len(label) <= 32,       "setLabel: label too long");
      labels[target] = label;
      return true;
    }

    function getLabel(target: u256) -> str { return labels[target]; }

    // ── Minting ────────────────────────────────────────────────────────────
    function mint(to: u256, amount: u256) -> u256 as caller {
      require(minter_role[caller] == true || admin_role[caller] == true, "mint: not authorised");
      require(to > 0,     "mint: invalid recipient");
      require(amount > 0, "mint: zero amount");
      registered[to]  = true;
      total_supply    = total_supply + amount;
      balances[to]    = balances[to] + amount;
      return total_supply;
    }

    // ── Transfers ──────────────────────────────────────────────────────────
    function transfer(to: u256, amount: u256) -> bool as caller {
      require(registered[caller] == true,   "transfer: sender not registered");
      require(registered[to] == true,       "transfer: recipient not registered");
      require(to > 0,                       "transfer: invalid recipient");
      require(to != caller,                 "transfer: cannot transfer to self");
      require(balances[caller] >= amount,   "transfer: insufficient balance");
      balances[caller] = balances[caller] - amount;
      balances[to]     = balances[to] + amount;
      return true;
    }

    function burn(from: u256, amount: u256) -> u256 as caller {
      require(admin_role[caller] == true,  "burn: not admin");
      require(balances[from] >= amount,    "burn: amount exceeds balance");
      balances[from] = balances[from] - amount;
      total_supply   = total_supply - amount;
      return total_supply;
    }

    // ── Debug control (admin only) ─────────────────────────────────────────
    function setDebugMode(enabled: bool) -> bool as caller {
      require(admin_role[caller] == true, "setDebugMode: not admin");
      debug_mode = enabled;
    }

    // ── Diagnostics (gated on debug_mode) ─────────────────────────────────
    function whoAmI() -> u256 as caller {
      require(debug_mode == true, "whoAmI: debug mode not enabled");
      return caller;
    }

    function amIRegistered() -> bool as caller {
      require(debug_mode == true, "amIRegistered: debug mode not enabled");
      return registered[caller];
    }

    // ── Identity helpers ───────────────────────────────────────────────────
    function amIAdmin() -> bool as caller    { return admin_role[caller]; }
    function amIMinter() -> bool as caller   { return minter_role[caller]; }

    // ── Token info (str builtins) ──────────────────────────────────────────
    // Returns "Name: <token_name> [<token_symbol>]" as a single string.
    function tokenInfo() -> str {
      return str_concat(str_concat(str_concat("Name: ", token_name), " ["), str_concat(token_symbol, "]"));
    }

    // Check if a given string matches the token symbol exactly.
    function isSymbol(s: str) -> bool { return str_eq(s, token_symbol); }

    // ── Queries ────────────────────────────────────────────────────────────
    function isAdmin(who: u256)      -> bool  { return admin_role[who]; }
    function isMinter(who: u256)     -> bool  { return minter_role[who]; }
    function isRegistered(who: u256) -> bool  { return registered[who]; }
    function balanceOf(who: u256)    -> u256  { return balances[who]; }
    function totalSupply()           -> u256  { return total_supply; }
    function tokenName()             -> str   { return token_name; }
    function tokenSymbol()           -> str   { return token_symbol; }
    function getVersion()            -> u256  { return version; }
    function isInitialised()         -> bool  { return initialised; }
    function isPQCEnabled()          -> bool  { return feat_pqc; }
  }
}
