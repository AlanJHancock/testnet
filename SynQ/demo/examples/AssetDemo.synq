pragma synq ^0.9;

contract AssetDemo {
  state {
    initialised: bool;
  }

  @public
  function init() as caller -> bool {
    initialised = true;
    return true;
  }

  @public
  function createAsset(quantity: u256) as caller -> (u256, u256) {
    let id = asset_create("SNRG", quantity);
    return (id, quantity);
  }

  @public
  function transferAsset(asset_id: u256, to: u256) as caller -> u256 {
    let new_id = asset_transfer(asset_id, to);
    return new_id;
  }

  @public
  function burnAsset(asset_id: u256) as caller -> u256 {
    let value = asset_burn(asset_id);
    return value;
  }

  @public
  function checkBalance(asset_id: u256) as caller -> u256 {
    return asset_balance(asset_id);
  }

  @public
  function checkOwner(asset_id: u256) as caller -> u256 {
    return asset_owner(asset_id);
  }

  @public
  function assetInfo(asset_id: u256) as caller -> (string, u256) {
    return ("SNRG", asset_balance(asset_id));
  }
}
