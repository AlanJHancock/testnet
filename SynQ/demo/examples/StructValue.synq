pragma synq ^0.9;

struct Point {
    x: u256;
    y: u256;
}

struct Rect {
    origin: Point;
    size: Point;
}

contract StructValue {
    state {
        corner: Point;
        box_val: Rect;
        initialised: bool;
    }

    @public
    function init() -> bool {
        corner = Point { x: 0, y: 0 };
        box_val = Rect { origin: Point { x: 1, y: 2 }, size: Point { x: 100, y: 200 } };
        initialised = true;
        return true;
    }

    @public
    function translate(p: Point, dx: u256, dy: u256) -> Point {
        let result = Point { x: p.x + dx, y: p.y + dy };
        return result;
    }

    // --- Test helpers for translate() ---------------------------------
    // Two ways to sanity-check translate() from the Forge "Run function"
    // panel without hand-typing struct fields every time:
    //
    // 1. testTranslateFixed() takes no arguments at all -- it runs
    //    translate() against a hardcoded p=(10,20), dx=5, dy=7 and just
    //    returns the resulting Point. Expected result is always (15, 27).
    //    Click Run with zero setup and eyeball the two numbers that come
    //    back.
    //
    // 2. checkTranslate(p, dx, dy) is a property check: it calls
    //    translate() with whatever p/dx/dy you type into the struct form,
    //    then asserts (via require) that the result actually equals
    //    p.x+dx and p.y+dy. It returns true only if translate is correct
    //    for those exact inputs, and reverts with a clear message showing
    //    the mismatch if not -- so you can probe edge cases (0, large
    //    values, etc.) and get a pass/fail instead of having to
    //    eyeball arithmetic yourself.

    @public
    function testTranslateFixed() -> Point {
        let base = Point { x: 10, y: 20 };
        return translate(base, 5, 7);
    }

    @public
    function checkTranslate(p: Point, dx: u256, dy: u256) -> bool {
        let result = translate(p, dx, dy);
        require(result.x == p.x + dx, "checkTranslate: x mismatch");
        require(result.y == p.y + dy, "checkTranslate: y mismatch");
        return true;
    }

    @public
    function getCorner() -> Point {
        return corner;
    }

    @public
    function makePoint(x: u256, y: u256) -> Point {
        return Point { x: x, y: y };
    }

    @public
    function getCornerX() -> u256 {
        return getCorner().x;
    }

    @public
    function getCornerY() -> u256 {
        return getCorner().y;
    }

    @public
    function getBoxOriginX() -> u256 {
        return box_val.origin.x;
    }

    @public
    function getBoxSizeY() -> u256 {
        return box_val.size.y;
    }

    @public
    @effects(corner)
    function setCorner(p: Point) -> bool {
        require(initialised, "StructValue.setCorner: not initialised");
        corner = p;
        return true;
    }

    @public
    function setCornerFromMake(x: u256, y: u256) -> bool {
        corner = makePoint(x, y);
        return true;
    }

    @public
    function moveCorner(dx: u256, dy: u256) -> bool {
        corner = translate(corner, dx, dy);
        return true;
    }

    @public
    @effects(box_val)
    function setBoxOrigin(p: Point) -> bool {
        require(initialised, "StructValue.setBoxOrigin: not initialised");
        box_val.origin = p;
        return true;
    }

    @public
    @effects(corner)
    function setCornerX(newX: u256) -> bool {
        // Nested field assignment variant where the assigned field is a
        // scalar (u256), not a struct -- corner.y must be left untouched.
        require(initialised, "StructValue.setCornerX: not initialised");
        corner.x = newX;
        return true;
    }
}