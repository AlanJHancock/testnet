pragma synq ^0.9;

// SimpleToken — ERC-20-style token for the SynQ devnet demo.
// Deploy after TokenVault in the same workspace.
contract SimpleToken {

  state {
    name:        str;
    symbol:      str;
    totalSupply:  u256;
    initialSupply: u256;
    owner:       u256;
    initialised: bool;
    balances:    map<u256, u256>;
  }

  function init(tokenName: str, tokenSymbol: str, supply: u256) -> bool as caller {
    if (initialised) { return false; }
    name        = tokenName;
    symbol      = tokenSymbol;
    totalSupply  = supply;
    initialSupply = supply;
    owner        = caller;
    balances[caller] = supply;
    initialised = true;
    return true;
  }

  function mint(to: u256, amount: u256) -> bool as caller {
    require(initialised, "not initialised");
    require(caller == owner, "not owner");
    balances[to]  = balances[to] + amount;
    totalSupply   = totalSupply + amount;
    return true;
  }

  function burn(from: u256, amount: u256) -> bool as caller {
    require(initialised, "not initialised");
    require(caller == owner, "not owner");
    require(balances[from] >= amount, "insufficient balance");
    balances[from] = balances[from] - amount;
    totalSupply    = totalSupply - amount;
    return true;
  }

  // WARNING: Direct transfers move tokens WITHOUT TokenVault knowing.
// If you use TokenVault.deposit/withdraw, avoid calling transfer() directly
// — it drains your balance and withdraw() will fail with insufficient balance.
  function transfer(to: u256, amount: u256) -> bool as caller {
    require(initialised, "not initialised");
    require(to != caller, "cannot transfer to self");
    require(balances[caller] >= amount, "insufficient balance");
    balances[caller] = balances[caller] - amount;
    balances[to]     = balances[to] + amount;
    return true;
  }

  function balanceOf(addr: u256) -> u256 {
    return balances[addr];
  }

  // Internal: called by TokenVault.withdraw() to verify balance before burn.
  function checkBalance(addr: u256, amount: u256) -> bool {
    require(balances[addr] >= amount, "insufficient token balance for vault withdrawal");
    return true;
  }

  function getOwner() -> u256 {
    return owner;
  }

  function getTotalSupply() -> u256 {
    return totalSupply;
  }

  // ── Internal: called by TokenVault.assertSync() via extern_call ──
  // Do not call directly — use TokenVault.assertSync() instead.
  // Verifies: totalSupply - initialSupply == vault net flow (totalIn - totalOut).
  function assertBalance(expected: u256) -> bool {
    require(totalSupply - initialSupply == expected, "assertBalance: supply delta mismatch");
    return true;
  }
}