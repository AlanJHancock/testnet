pragma synq ^0.9;

contract Counter {
  state {
    counter: u256;
    initialised: bool;
  }

  impl {
    @public
    function init() -> bool {
      counter = 0;
      initialised = true;
      return true;
    }

    @public
    function increment(amt: u256) -> u256 {
      counter = counter + amt;
      return counter;
    }

    @public
    function get() -> u256 {
      return counter;
    }
  }
}