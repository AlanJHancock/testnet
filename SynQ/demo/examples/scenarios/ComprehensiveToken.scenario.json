{
  "version": 1,
  "contract": "ComprehensiveToken",
  "scenarios": [
    {
      "name": "init -> metadata (str_len/str_concat/str_eq) -> delegated roles -> delegated mint -> party-to-party transfer -> burn -> labels -> revokes. All caller identities use the canonical 16-byte big-endian identity slot at bytes[5..21], matching Value::as_address()'s own numeric-literal encoding -- this is required since the 2026-08-25 map-key fix (aivm-scenario-testing-backlog.md item 7) canonicalizes Value::Address map keys through that exact slot.",
      "steps": [
        {
          "call": "init",
          "args": [
            "Synergy Token",
            "SNRG"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "isInitialised",
          "args": [],
          "expectReturn": true
        },
        {
          "call": "tokenName",
          "args": [],
          "expectReturn": "Synergy Token"
        },
        {
          "call": "tokenSymbol",
          "args": [],
          "expectReturn": "SNRG"
        },
        {
          "call": "getVersion",
          "args": [],
          "expectReturn": 2
        },
        {
          "call": "isPQCEnabled",
          "args": [],
          "expectReturn": true
        },
        {
          "call": "setDebugMode",
          "args": [
            true
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "whoAmI",
          "args": [],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000"
        },
        {
          "call": "amIAdmin",
          "args": [],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "amIRegistered",
          "args": [],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "isAdmin",
          "args": [
            1
          ],
          "expectReturn": true
        },
        {
          "call": "isRegistered",
          "args": [
            1
          ],
          "expectReturn": true
        },
        {
          "call": "tokenInfo",
          "args": [],
          "expectReturn": "Name: Synergy Token [SNRG]"
        },
        {
          "call": "isSymbol",
          "args": [
            "SNRG"
          ],
          "expectReturn": true
        },
        {
          "call": "isSymbol",
          "args": [
            "WRONG"
          ],
          "expectReturn": false
        },
        {
          "call": "grantMinter",
          "args": [
            2
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "isMinter",
          "args": [
            2
          ],
          "expectReturn": true
        },
        {
          "call": "grantAdmin",
          "args": [
            5
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "isAdmin",
          "args": [
            5
          ],
          "expectReturn": true
        },
        {
          "call": "register",
          "args": [
            3
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "register",
          "args": [
            4
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "isRegistered",
          "args": [
            3
          ],
          "expectReturn": true
        },
        {
          "call": "isRegistered",
          "args": [
            4
          ],
          "expectReturn": true
        },
        {
          "call": "setLabel",
          "args": [
            3,
            "Alice"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "getLabel",
          "args": [
            3
          ],
          "expectReturn": "Alice"
        },
        {
          "call": "mint",
          "args": [
            3,
            500
          ],
          "caller": "0x0000000000000000000000000000000000000000020000000000000000000000000000000000000000",
          "expectReturn": 500
        },
        {
          "call": "balanceOf",
          "args": [
            3
          ],
          "expectReturn": 500
        },
        {
          "call": "totalSupply",
          "args": [],
          "expectReturn": 500
        },
        {
          "call": "transfer",
          "args": [
            4,
            150
          ],
          "caller": "0x0000000000000000000000000000000000000000030000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "balanceOf",
          "args": [
            3
          ],
          "expectReturn": 350
        },
        {
          "call": "balanceOf",
          "args": [
            4
          ],
          "expectReturn": 150
        },
        {
          "call": "burn",
          "args": [
            3,
            50
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": 450
        },
        {
          "call": "balanceOf",
          "args": [
            3
          ],
          "expectReturn": 300
        },
        {
          "call": "totalSupply",
          "args": [],
          "expectReturn": 450
        },
        {
          "call": "revokeMinter",
          "args": [
            2
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "isMinter",
          "args": [
            2
          ],
          "expectReturn": false
        },
        {
          "call": "revokeAdmin",
          "args": [
            5
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "isAdmin",
          "args": [
            5
          ],
          "expectReturn": false
        }
      ]
    },
    {
      "name": "guard rail: init() rejects an empty name (str_len check)",
      "steps": [
        {
          "call": "init",
          "args": [
            "",
            "SNRG"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectStatus": "reverted"
        }
      ]
    },
    {
      "name": "guard rail: init() rejects a name over 64 chars (str_len check)",
      "steps": [
        {
          "call": "init",
          "args": [
            "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "SNRG"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectStatus": "reverted"
        }
      ]
    },
    {
      "name": "guard rail: init() rejects a symbol over 8 chars (str_len check)",
      "steps": [
        {
          "call": "init",
          "args": [
            "Synergy Token",
            "TOOLONGSYM"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectStatus": "reverted"
        }
      ]
    },
    {
      "name": "guard rail: revokeAdmin() cannot revoke self",
      "steps": [
        {
          "call": "init",
          "args": [
            "Synergy Token",
            "SNRG"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "revokeAdmin",
          "args": [
            1
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectStatus": "reverted"
        }
      ]
    },
    {
      "name": "guard rail: revokeAdmin() cannot remove the last admin",
      "steps": [
        {
          "call": "init",
          "args": [
            "Synergy Token",
            "SNRG"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "revokeAdmin",
          "args": [
            99
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectStatus": "reverted"
        }
      ]
    },
    {
      "name": "guard rail: mint() reverts for a caller with no admin/minter role at all",
      "steps": [
        {
          "call": "init",
          "args": [
            "Synergy Token",
            "SNRG"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "mint",
          "args": [
            2,
            100
          ],
          "caller": "0x0000000000000000000000000000000000000000020000000000000000000000000000000000000000",
          "expectStatus": "reverted"
        }
      ]
    },
    {
      "name": "guard rail: deregister() reverts while the target still holds a balance",
      "steps": [
        {
          "call": "init",
          "args": [
            "Synergy Token",
            "SNRG"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "mint",
          "args": [
            3,
            500
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": 500
        },
        {
          "call": "deregister",
          "args": [
            3
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectStatus": "reverted"
        }
      ]
    },
    {
      "name": "guard rail: transfer() reverts when the recipient isn't registered",
      "steps": [
        {
          "call": "init",
          "args": [
            "Synergy Token",
            "SNRG"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "register",
          "args": [
            3
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "mint",
          "args": [
            3,
            100
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": 100
        },
        {
          "call": "transfer",
          "args": [
            4,
            50
          ],
          "caller": "0x0000000000000000000000000000000000000000030000000000000000000000000000000000000000",
          "expectStatus": "reverted"
        }
      ]
    },
    {
      "name": "guard rail: transfer() reverts on transfer-to-self",
      "steps": [
        {
          "call": "init",
          "args": [
            "Synergy Token",
            "SNRG"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "register",
          "args": [
            3
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "mint",
          "args": [
            3,
            100
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": 100
        },
        {
          "call": "transfer",
          "args": [
            3,
            50
          ],
          "caller": "0x0000000000000000000000000000000000000000030000000000000000000000000000000000000000",
          "expectStatus": "reverted"
        }
      ]
    },
    {
      "name": "guard rail: transfer() reverts on insufficient balance",
      "steps": [
        {
          "call": "init",
          "args": [
            "Synergy Token",
            "SNRG"
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "register",
          "args": [
            3
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "register",
          "args": [
            4
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": true
        },
        {
          "call": "mint",
          "args": [
            3,
            50
          ],
          "caller": "0x0000000000000000000000000000000000000000010000000000000000000000000000000000000000",
          "expectReturn": 50
        },
        {
          "call": "transfer",
          "args": [
            4,
            999
          ],
          "caller": "0x0000000000000000000000000000000000000000030000000000000000000000000000000000000000",
          "expectStatus": "reverted"
        }
      ]
    }
  ]
}