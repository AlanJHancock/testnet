// ═══ PQC DEMO ═══════════════════════════════════════════════════════════════
// PQCDemo — Post-Quantum Cryptography Verification Demo
// Demonstrates ML-DSA-65 (Dilithium3) signature verification
// using the legacy direct-call opcode (0x80).
// Also demonstrates ML-KEM-768 decapsulation (opcode 0x81).
//
// ACTS-15 §3: ML-DSA verify is a deterministic public operation.
//             ML-KEM decapsulate requires a secret key and is
//             rejected by the AEG1 deterministic dispatcher (0x8F).
//             The legacy opcodes (0x80-0x83) bypass AEG1 dispatch
//             and call the PQC shim directly.
contract PQCDemo {
  state {
    initialised: bool;
    pk: bytes;
    sig: bytes;
    msg: bytes;
  }

  impl {
    @public
    function init() -> bool {
      if (initialised) { return false; }
      initialised = true;
      return true;
    }

    // Store a public key for later verification
    @public
    function setPublicKey(key: bytes) -> bool {
      pk = key;
      return true;
    }

    // Store a signature for later verification
    @public
    function setSignature(s: bytes) -> bool {
      sig = s;
      return true;
    }

    // Store a message for later verification
    @public
    function setMessage(m: bytes) -> bool {
      msg = m;
      return true;
    }

    // Verify stored signature using ML-DSA-65 (Dilithium3)
    // Returns true if signature is valid for stored message + stored key
    @public
    function verifyStored() -> bool {
      require(initialised, "not initialised");
      return dilithium_verify(msg, sig, pk);
    }

    // Direct ML-DSA-65 verification — pass all three as arguments
    // Source order: (message, signature, public_key)
    @public
    function verifyMlDsa(message: bytes, signature: bytes, publicKey: bytes) -> bool {
      return dilithium_verify(message, signature, publicKey);
    }

    // Direct FN-DSA-512 (Falcon) verification
    @public
    function verifyFnDsa(message: bytes, signature: bytes, publicKey: bytes) -> bool {
      return falcon_verify(message, signature, publicKey);
    }

    // ML-KEM-768 decapsulation — requires ciphertext + secret key
    // NOTE: This uses the legacy opcode 0x81 which bypasses AEG1 dispatch.
    // The AEG1 deterministic dispatcher (0x8F) would reject this operation
    // per ACTS-15 §3 (requires secret key material).
    // Returns the shared secret as bytes.
    @public
    function decapsMlKem(ciphertext: bytes, secretKey: bytes) -> bytes {
      return kyber_decaps(ciphertext, secretKey);
    }
  }
}