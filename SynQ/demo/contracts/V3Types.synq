pragma synq ^0.9;

// V3 Types Demo — new type aliases, attributes, authority model,
// and Bech32 address builtins for Testnet-v3 alignment.

enum Role { Admin, Minter, User }

contract V3Types {
  state {
    initialised: bool;
    owner: Bytes<20>;
    blockHeight: Height;
    sessionId: Hash32;
    umaId: UMAIdentity;
    storedValue: u256;
  }

  // init: @public + @effects + as caller
  // Stores caller address and extracts UMA identity from authority envelope.
  @public
  @effects(initialised, owner, umaId)
  function init() as caller -> bool {
    if (initialised) { return false; }
    initialised = true;
    owner = caller;
    let env = authority_identity(authority_envelope());
    umaId = env;
    return true;
  }

  // Returns owner address as syna... Bech32 string.
  @public
  function getOwnerSyna() -> str {
    return to_syna(owner);
  }

  // Returns current caller as syna... Bech32 string.
  @public
  function getCallerSyna() as caller -> str {
    return to_syna(caller);
  }

  // Returns the UMA identity stored during init.
  @public
  function getUmaId() -> u256 {
    return umaId;
  }

  // Sets a session hash (Hash32 type alias).
  @public
  @effects(sessionId)
  function setSessionId(h: Hash32) as caller -> bool {
    sessionId = h;
    return true;
  }

  @public
  function getSessionId() -> u256 {
    return sessionId;
  }

  // @authority(AdminScope) — on devnet, server envelopes accept any scope.
  @authority(AdminScope)
  @effects(storedValue)
  function setValue(v: u256) as caller -> bool {
    storedValue = v;
    return true;
  }

  @public
  function getValue() -> u256 {
    return storedValue;
  }

  // Derives a sync... contract address via V3 Bech32.
  @public
  function deriveContractAddr(deployer: u256, nonce: u256, artifactHash: u256) -> str {
    return contract_address(deployer, nonce, artifactHash);
  }

  // Decodes a syna... string back to a u256 address.
  @public
  function parseSyna(s: str) -> u256 {
    return from_syna(s);
  }

  @public
  function getBlockHeight() -> u256 {
    return blockHeight;
  }

  @public
  @effects(blockHeight)
  function setBlockHeight(h: Height) as caller -> bool {
    blockHeight = h;
    return true;
  }
}